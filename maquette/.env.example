# Copier en .env.local puis renseigner APRÈS accord écrit de l'établissement.
# Laisser vide pendant la démonstration : le bouton WhatsApp affiche alors un avertissement
# au lieu d'ouvrir une conversation avec un vrai numéro.

# Numéro WhatsApp au format international, chiffres uniquement (ex. 2250700000000).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publique définitive du site (sert aux métadonnées, au sitemap et au JSON-LD).
NEXT_PUBLIC_SITE_URL=

# "demo" (défaut) : bandeau de démonstration + pages non indexées par les moteurs.
# "production" : uniquement quand tous les contenus ont été validés par l'établissement.
NEXT_PUBLIC_SITE_MODE=demo
